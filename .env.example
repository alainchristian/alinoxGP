# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3100
APP_BASE_URL=http://localhost:5273

# Three database roles (ADR-0003). Dev passwords match infra/docker-compose.dev.yml defaults.
DATABASE_URL=postgresql://gps_app:gps_app_dev@localhost:54329/gps
DATABASE_URL_SYSTEM=postgresql://gps_system:gps_system_dev@localhost:54329/gps
DATABASE_URL_MIGRATE=postgresql://gps_owner:gps_owner_dev@localhost:54329/gps
SHADOW_DATABASE_URL=postgresql://gps_owner:gps_owner_dev@localhost:54329/gps_shadow

REDIS_URL=redis://localhost:63799/0

# Auth (ADR-0002). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-change-me-dev-only-change-me
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Email: "dev" logs messages (development only; refused when NODE_ENV=production).
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@gps.local

# Rate limits
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# GPS engine (Milestone 2). Traccar runs from infra/docker-compose.dev.yml (pinned 6.16.0).
GPS_ENGINE=traccar
TRACCAR_URL=http://localhost:58082
# Dedicated Traccar ADMINISTRATOR for the API. Create it once on a fresh server (the first POST /api/users becomes
# admin) and keep the password only in the environment. Never expose Traccar's port 8082 publicly.
TRACCAR_USER=gps-service@platform.local
TRACCAR_PASSWORD=change-me-generate-a-random-password
# OsmAnd port used by the simulator only.
TRACCAR_OSMAND_URL=http://localhost:55055
# Run the single-leader stream consumer and BullMQ workers on this instance.
INGESTION_ENABLED=true
WORKERS_ENABLED=true
# Simulated devices (SIM-…) are only valid in sandbox organizations; MUST be false in production.
SIMULATOR_ENABLED=true
# Host/IP devices connect to (shown in onboarding instructions). Leave empty until the production GPS server address is known.
GPS_SERVER_HOST=
# Require acknowledging the published tracking notice when registering a device.
DEVICE_CONSENT_REQUIRED=true

# --- M3 pipeline tunables (defaults shown; all optional) ---
# ROUTING_CACHE_TTL_SEC=300       # in-process device->vehicle routing cache; must exceed the devices' reporting interval. Changes are pushed to all instances via Redis.
# STATE_PERSIST_INTERVAL_SEC=30   # coalesced write-through of live state to PostgreSQL (status changes are written at once)
# SWEEP_INTERVAL_SEC=30           # offline sweeper period
# LIVE_STATE_REDIS_FLUSH_MS=250  # the ingestion leader writes its in-memory live state to Redis in one atomic, lease-checked batch this often
# FANOUT_FLUSH_MS=1000            # Socket.IO delta coalescing window
# PIPELINE_DELAYED_AFTER_SEC=120  # serverTime - fixTime above this marks a fix as delayed (no real-time alerts)

# --- M4 map (ADR-0008) ---
# MAP_PROVIDER=dev-osm                    # dev-osm = OpenStreetMap tiles for DEVELOPMENT only (refused in production); mapbox = production
# MAP_DEV_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAPBOX_PUBLIC_TOKEN=                    # a PUBLIC token (pk.…) when MAP_PROVIDER=mapbox; a secret sk.… token is refused
# TRACKING_SNAPSHOT_LIMIT=5000            # most vehicles returned by GET /tracking/snapshot (the live map's starting point)
