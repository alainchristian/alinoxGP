{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "incremental": true,
    "isolatedModules": false,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"],
    "noEmit": false
  },
  "include": ["src", "test", "prisma/seed"]
}
