{
  "name": "@gps/simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "sim": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean",
    "sim": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@gps/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@gps/shared": "workspace:*",
    "socket.io-client": "^4.8.4"
  }
}
